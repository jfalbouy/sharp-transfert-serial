10 '-----------------------------------
20 '- LFILES30.BAS         14/07/19   -
30 '-----------------------------------
40 CLS :CLEAR :ON ERROR GOTO *ERR
50 '
60 'Installation de routines
70 'Pour Media Parameter Block
80 MEDIA=&BFA00:DRIVE=&BFAEE:MPARAM=&BFAF3:LEADAD=&BFAF6:FATADD=&BFAF9:MXFILE=&BFAFE
90 'Pour Display Guide
100 DISPLAY=&BFAB3:NUMBER=&BFAEF:CUX=&BFAF0:CUY=&BFAF1:NMENU=&BFAF2:ERRF=&BFAEA:MENU=&BFB48
110 'Pour Rename et Delete
120 REN=&BFA55,DELE=&BFA9E:FILE1=&BFB00:FILE2=&BFB14:FILE3=&BFB28
130 '
140 'Declaration et initialisation des variables ---
150 DIM N$(2),E$(2),A$(2),T(2):CD$="<>![]\|~?:.,;*-+/=":ME=0
160 FOR I=1 TO 8:R$=R$+CHR$ 0:NEXT I:R$=R$+"."+CHR$ 0+CHR$ 0+CHR$ 0
170 ADR=MEDIA:ADRMEN=MENU
180 '
190 'Verification de la taille en mémoire ---
200 IF (PEEK &BFD1C*&10000+PEEK &BFD1B*&100+PEEK &BFD1A)<=ADR THEN 300
210 GOSUB *TIT:LOCATE 0,2:PRINT "Memoire insuffisante, reset (O/N) ?"
220 W$=INPUT $(1):IF W$<>"O" AND W$<>"N" THEN 210
230 IF W$="N" THEN GOTO *END
240 '
250 'Initialisation mémoire ---
260 TAILLE=&BFC00-ADR:IF (PEEK &BFD1C*&10000+PEEK &BFD1B*&100+PEEK &BFD1A)<=ADR THEN END
270 TH=INT (TAILLE/&10000):TM=INT ((TAILLE-TH*&10000)/&100):TL=TAILLE-TH*&10000-TM*&100
280 POKE &BFE03,&1A,&FD,&B,TL,TM,TH:CALL &FFFD8
290 '
300 'Check si deja implante ---
310 RESTORE *CODE:FOR I=0 TO 15:READ C$
320 IF PEEK (ADR+I)<>VAL ("&"+C$) THEN 350
330 NEXT I:GOTO 430
340 '
350 'Lecture des codes et implantation en memoire ---
360 RESTORE *CODE: I=0
370 LOCATE 10,2:PRINT "Implantation en cours..."
380 READ C$:IF C$<>"@" THEN POKE ADR+I,VAL ("&"+C$):I=I+1:GOTO 380
390 '
400 'Menu selection du drive ---
410 GOSUB *IMPMEN:GOSUB *TAB2
420 IF PEEK &BFC14<>1 THEN *ERRCERAM
430 *MEN GOSUB *TIT:LOCATE 16,2:PRINT "E:   ...1":LOCATE 16,3:PRINT "F:   ...2"
440 '
450 'Fin du programme pour les touches MENU, BASIC et C-CE ---
460 GOSUB *TKEY:IF W=&2 OR W=&8 OR W=&9 THEN *END
470 W=W-ASC "0":IF W<1 OR W>2 THEN 460
480 POKE DRIVE,-(W=2):D$=CHR$ (ASC "E"-(W=2))
490 '
500 'Fonction &11 IOCS, lecture du Media parameter block address ---
510 CALL ADR:IF PEEK ERRF<>0 THEN GOSUB *ERRMED:GOSUB *TKEY:GOTO *MEN
520 '
530 'Lecture de l'adresse de la FAT -----------------------
540 S=PEEK (FATADD)+PEEK (FATADD+1)*&100+PEEK (FATADD+2)*&10000
550 '
560 'Lecture de nb de fichiers presents et max sur la carte
570 N=0:NF=PEEK MXFILE
580 IF PEEK (S+32*N)<>0 THEN N=N+1:GOTO 580
590 IF N=0 THEN GOSUB *ERRFICH
600 '
610 'Gestion de affichage ---
620 FAT=S:I=1:L=0
630 '
640 'Affichage du menu sur la derniere ligne et verrouillage
650 *SC0 POKE &BFC9E,4:CLS :ME=0:GOSUB *GMEN:POKE &BFC9E,3:LOCATE 0,0:GOTO *SC4
660 '
670 'Effacement d'une portion de l'ecran
680 *SC1 FOR P=0 TO 2:LOCATE 0,P:GOSUB *CLEAR:NEXT P:LOCATE 0,0
690 *SC4 K=0
700 *SC2 GOSUB *AFC
710 S=S+32:K=K+1:I=I+1:IF K<>3 AND I<=N THEN *SC2
720 '
730 *DRV LOCATE 37,0:PRINT D$;":"
740 *CUR LOCATE 0,L:PRINT CHR$ &E4
750 '
760 *SC3 GOSUB *TKEY
770 '
780 'Changement de page dans la carte
790 IF W<>ASC "P" THEN 840
800 PAGE=PAGE+1:IF PAGE>3 THEN PAGE=0
810 POKE &10000,PAGE:POKE &BFC9E,4:GOTO 510
820 '
830 'Touches Fleche-bas, Fleche-droite, +
840 IF (W=&5 OR W=&0E OR W=&2B) AND I=N+1 AND (L=2 OR N=K) THEN *SC3
850 '
860 'Touches Fleche-haut, Fleche-gauche, -
870 IF (W=&4 OR W=&0F OR W=&2D) AND L=0 AND (I=4 OR N<I) THEN GOTO *SC3
880 '
890 'Touches Fleche-bas
900 IF W=&5 THEN GOSUB *CLRCUR:IF L=2 THEN GOSUB *SCRUP:GOSUB *CHGF1:K=2:GOSUB *AFC:I=I+1:GOTO *CALS ELSE L=L+1:GOTO *CUR
910 '
920 'Touches Fleche-haut
930 IF W=&4 THEN GOSUB *CLRCUR:IF L=0 THEN LOCATE 37,0:PRINT "  ":GOSUB *SCRDN:GOSUB *CHGF2:K=0:S=S-128:GOSUB *AFC:I=I-1:GOTO *CALS ELSE L=L-1:GOTO *CUR
940 '
950 'Touches Fleche-droite
960 IF W=&0E THEN GOSUB *CLRCUR:IF I<N+1 THEN I=N-2:L=2:GOTO *CALS ELSE L=2:GOTO *CUR
970 '
980 'Touches Fleche-gauche
990 IF W=&0F THEN GOSUB *CLRCUR:IF I>4 THEN I=1:S=FAT:L=0:GOTO *SC1 ELSE L=0:GOTO *CUR
1000 '
1010 'Touches +
1020 IF W=&2B THEN GOSUB *CLRCUR:IF I=N+1 THEN L=2:GOTO *CUR ELSE IF I>N-3 THEN I=N-2:GOTO *CALS ELSE GOTO *CALS
1030 '
1040 'Touches -
1050 IF W=&2D THEN IF I=4 THEN GOSUB *CLRCUR:L=0:GOTO *CUR ELSE IF I>6 THEN I=I-6:GOTO *CALS ELSE GOTO *CALS
1060 '
1070 'Touches C-CE
1080 IF W=&2 THEN POKE &BFC9E,4:GOTO *MEN ELSE W=W-240
1090 IF W<1 OR W>5 THEN *SC3
1100 POKE &BFC9E,4:ON W GOSUB *NAME, *EXT, *ATT, *KILL, *INFO
1110 IF W=4 THEN *MEN
1120 S=S-96:I=I-3:GOTO *SC0
1130 '
1140 'Calcul nouvelle adresse en fonction du deplacement
1150 *CALS S=FAT+(I-1)*32:IF (W=&4 OR W=&5) THEN *DRV ELSE *SC1
1160 '
1170 'Suppression de fichiers ---
1180 *KILL IF N$(L)=R$ THEN RETURN
1190 IF LEFT$ (N$(L),1)=CHR$ &E5 THEN POKE S-96+L*32,ASC "~":RETURN
1200 F1$=D$+":    "+N$(L)+"."+E$(L)+CHR$ 0
1210 FOR IC=0 TO LEN F1$:POKE (FILE1+IC),ASC (MID$ (F1$,IC+1,1)):NEXT IC
1220 CALL DELE:IF PEEK ERRF<>0 THEN GOTO *ERRDEL ELSE RETURN
1230 '
1240 'Renommage de fichiers ---
1250 *NAME :IF N$(L)=R$ THEN RETURN
1260 CLS :NFILE$="":GOSUB *VIN:PRINT " RENAME ":GOSUB *VNO
1270 'MCAR=8:N$=N$(L):T$="NOUVEAU NOM : [":GOSUB *NAME1:NFILE$=NFILE$+"."
1272 MCAR=8:N$=N$(L):T$="NOUVEAU NOM : [":GOSUB *RENAME
1274 IF NK$=N$ THEN RETURN ELSE NFILE$=NFILE$+NK$+"."
1280 'MCAR=3:N$=E$(L):T$="NOUVEAU EXT : [":GOSUB *NAME1:NFILE$=NFILE$+CHR$ 0
1282 MCAR=3:N$=E$(L):T$="NOUVEAU EXT : [":GOSUB *RENAME:NFILE$=NFILE$+NK$+CHR$ 0
1290 FOR H=0 TO 18:POKE (FILE3+H),ASC (MID$ (NFILE$,H+1,1)):NEXT H
1300 IF LEFT$ (N$(L),1)=CHR$ &E5 THEN N$(L)="z"+RIGHT$ (N$(L),LEN N$(L)-1)
1310 NFILE$=D$+":    "+N$(L)+"."+E$(L)+CHR$ 0
1320 FOR H=0 TO 18:POKE (FILE1+H),ASC (MID$ (NFILE$,H+1,1)):NEXT H
1330 CALL REN:IF PEEK ERRF<>0 THEN *ERRNAME ELSE RETURN
1340 '*NAME1 GOSUB *RENAME:NFILE$=NFILE$+NK$:RETURN
1350 '
1360 *RENAME
1370 COL=0:NK$="":
1380 GOSUB *VNO:LOCATE 0,2:PRINT T$;LEFT$ (N$,MCAR);"]     ";
1390 GOSUB *VIN:LOCATE 15+COL,2:PRINT MID$ (N$,COL+1,1);:NM$=INPUT $(1)
1400 IF NM$=CHR$ 13 THEN 1440
1410 GOSUB *CHEKIN:IF NOKIN THEN 1390
1420 LOCATE 15+COL,2:PRINT NM$;:NK$=NK$+NM$
1430 IF COL<MCAR-1 THEN COL=COL+1:GOTO 1390
1440 IF NK$="" THEN NK$=N$
1442 'IF N$=NK$ THEN 1460
1450 IF LEN NK$<MCAR THEN NK$=NK$+" ":GOTO 1450
1460 GOSUB *VNO:RETURN
1470 '
1480 'Verification si caractere interdit
1490 FOR H=1 TO Z:C$=MID$ (Z$,H,1):W=ASC C$
1500 IF (W>&40 AND W<&5B) OR (W>&60 AND W<&7B) OR (W>&2F AND W<&3A) THEN 1520
1510 FOR M=1 TO LEN CD$:IF C$=MID$ (CD$,M,1) THEN Z$="":RETURN ELSE NEXT M
1520 NEXT H:RETURN
1530 '
1540 'Modification de l'extension de fichier ---
1550 *EXT: IF N$(L)=R$ THEN RETURN
1560 CLS :GOSUB *VIN:PRINT " CHANGE EXTENSION ":GOSUB *VNO
1570 E$=E$(L):LOCATE 0,2:PRINT "Nouvelle extension : ";E$;" ";:INPUT E$
1580 IF E$=E$(L) THEN RETURN
1590 IF LEN E$<1 OR LEN E$>3 THEN 1560
1600 IF LEN E$<3 THEN E$=E$+" ":GOTO 1600
1610 Z$=E$:Z=3:GOSUB 1490:IF Z$="" THEN GOSUB *ERRCAR:GOTO 1560
1620 FOR H=1 TO 3:POKE S-96+L*32+H+7,ASC (MID$ (E$,H,1)):NEXT H:RETURN
1630 '
1640 'Modification de l'attribut de fichier ---
1650 *ATT :IF N$(L)=R$ THEN RETURN
1660 CLS :LOCATE 0,1:PRINT CHR$ &E4;:PRINT N$(L)+"."+E$(L)+" "+A$(L):GOSUB *VIN:LOCATE 23,0:PRINT " CHANGE ATTRIBUT ":GOSUB *VNO
1670 ME=1:GOSUB *GMEN
1680 GOSUB *TKEY:IF W<&F1 OR W>&F5 THEN 1680
1690 IF W=&F5 THEN RETURN ELSE IF W=&F4 THEN 1680
1700 POKE S-96+L*32+11,W-209:RETURN
1710 '
1720 *INFO CLS :DF=INT (DSKF (3-(PEEK DRIVE<>0))/1024):GOSUB *VIN:PRINT " DISK INFO ":GOSUB *VNO
1730 LOCATE 22,0:PRINT "DISK name : <";CHR$ (ASC "E"-(PEEK DRIVE<>0));":>"
1740 LOCATE 0,2:PRINT "Disk free   / capacity : ";DF;"/";PEEK &BFC12*2;"KB"
1750 PRINT "Files number / Maximum : ";N;"/";NF
1760 GOSUB *TKEY:RETURN
1770 '
1780 *TIT:CLS :LOCATE 11,0:PRINT "* DIRECTORIES *":RETURN
1790 *TKEY:W$=INKEY$ &1:IF W$="" THEN *TKEY ELSE W=ASC W$:RETURN
1800 *ERR: MER$="Erreur "+STR$ ERN +" en ligne "+STR$ ERL :GOTO *AFFERR
1810 *AFFERR:CLS :BEEP 1,10:WAIT 80:LOCATE 10,2:PRINT MER$:WAIT 0:GOTO *END
1820 *ERRCERAM: MER$="Carte memoire non installee ou defectueuse !":GOTO *AFFERR
1830 *ERRCAR: MER$="Caractere non valide !":GOTO *AFFERR
1840 *ERRFICH: MER$="Aucun fichier sur la carte !":GOTO *AFFERR
1850 *ERRMED: MER$="Erreur Media Parameter Block !":GOTO *AFFERR
1860 *ERROR:MER$="Calcul impossible":GOTO *AFFERR
1870 *ERRDEL MER$="SUPPRESSION IMPOSSIBLE !":GOTO *AFFERR
1880 *ERRNAME MER$="RENOMMAGE IMPOSSIBLE !":GOTO *AFFERR
1890 *END: GOSUB *TAB1:POKE &BFC9E,4:CLS :END
1900 '
1910 *AFC 'Lecture du nom de fichier
1920 N$(K)="":FOR J=S TO S+7:N$(K)=N$(K)+CHR$ PEEK J:NEXT J
1930 '
1940 'Lecture de l'extension de fichier
1950 E$(K)="":FOR J=S+8 TO S+10:E$(K)=E$(K)+CHR$ PEEK J:NEXT J
1960 '
1970 'Lecture de l'attribut de fichier
1980 A=PEEK (S+11) AND &0F
1990 IF A=0 OR A=4 OR A=8 OR A=12 THEN A$(K)=" ":GOTO *AFT
2000 IF A=1 OR A=5 OR A=9 OR A=13 THEN A$(K)="P" ELSE A$(K)="I"
2010 '
2020 'Lecture de la taille de fichier et affichage ligne
2030 *AFT T(K)=PEEK (S+28)+PEEK (S+29)*&100+PEEK (S+30)*&10000+PEEK (S+31)*&1000000 'Taille fichier
2040 BB=PEEK (FAT+(I-1)*32+27)*256+PEEK (FAT+(I-1)*32+26):ZA=FAT+NF*32+256*(BB-2)
2050 LOCATE 1,K:PRINT USING "&&&&&&&&.&&& & &&&&&&:[&&&&&][&&&&&]";N$(K);E$(K);A$(K);STR$ T(K);HEX$ S;HEX$ ZA:RETURN
2060 '
2070 'Glissement des informations fichiers vs SCRUP et SCRDN
2080 *CHGF1 N$(0)=N$(1):N$(1)=N$(2):E$(0)=E$(1):E$(1)=E$(2):A$(0)=A$(1):A$(1)=A$(2):T(0)=T(1):T(1)=T(2):RETURN
2090 *CHGF2 N$(2)=N$(1):N$(1)=N$(0):E$(2)=E$(1):E$(1)=E$(0):A$(2)=A$(1):A$(1)=A$(0):T(2)=T(1):T(1)=T(0):RETURN
2100 '
2110 'Routines d'ecran ---
2120 *SCRUP POKE &D4,0,0,0,0,0,0:POKE &BFE00,&0B,&47,0,8,1,3,&E8,&FF,&0F:CALL &BFE00:RETURN
2130 *SCRDN POKE &D4,0,0,0,0,0,0:POKE &BFE00,&0B,&48,0,8,1,3,&E8,&FF,&0F:CALL &BFE00:RETURN
2140 *CLEAR POKE &D4,0,P,0,0,0,0:POKE &BFE00,&0B,&52,0,8,&25,3,&E8,&FF,&0F:CALL &BFE00:RETURN
2150 *CLRCUR LOCATE 0,L:PRINT " ":RETURN
2160 '
2170 'Implantation des menus ---
2180 *IMPMEN RESTORE *MENU1:A=ADRMEN:GOSUB *IMP1:RESTORE *MENU2:A=ADRMEN+50
2190 *IMP1 FOR I=1 TO 5:READ C$,A$:POKE A,VAL ("&"+C$):A=A+1
2200 FOR J=1 TO LEN A$:POKE A,ASC MID$ (A$,J,1):A=A+1:NEXT J
2210 NEXT I:POKE A,&FF:RETURN
2220 '
2230 'Execution des menus ---
2240 *GMEN POKE NUMBER,6,0,3,-(ME=1):CALL DISPLAY:RETURN
2250 '
2260 'Menu de bas d'ecran
2270 *MENU1 DATA FE,NAME,FF,EXT,FF,ATT,FF,KILL,FF,INFO,FF,FE
2280 *MENU2 DATA FE,NORMAL,FF,PROTEC,FF,INVISI,FF," ",FF,CANCEL,FF,FE
2290 '
2300 'routines generales
2310 *VIN:POKE &BFCA1,&FF:RETURN
2320 *VNO:POKE &BFCA1,&0:RETURN
2330 *TAB1:POKE &BFC8A,&55,&24,&F,&95,&26,&F:POKE &BFC93,&15,&25,&F:RETURN
2340 *TAB2:POKE &BFC8A,&0,&FD,&D,&40,&FF,&D:POKE &BFC93,&C0,&FD,&D:RETURN
2350 *TAB3:POKE &BFC8A,&55,&24,&F,&95,&26,&F:POKE &BFC93,&39,&27,&F:RETURN
2360 '
2370 '
2380 'Verification si caractere interdit
2390 *CHEKIN IF (NM$<"A" OR NM$>"Z") AND (NM$<"0" OR NM$>"9") AND (NM$<"a" OR NM$>"z") THEN 2410
2400 FOR M=1 TO LEN CD$:IF NM$=MID$ (CD$,M,1) THEN NOKIN=1:RETURN ELSE NEXT M
2410 NOKIN=0:RETURN
