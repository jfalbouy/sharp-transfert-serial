10000 QMSG$="*  STABLE ISOTOPE  *"
10020 QDI=100:QDM=386:QSI=401:QSM=483
10030 CLS :LOCATE 9,0:PRINT QMSG$:Q4$=""
10040 LOCATE 4,2:PRINT "Atomic Symbol= ";:INPUT Q4$
10050 IF Q4$="" THEN R6=QDI:GOTO 10160 ELSE QLN=LEN Q4$
10060 IF QLN=1 THEN 10100 ELSE IF QLN>=3 THEN 10460
10070 QK1$=LEFT$ (Q4$,1):QK2$=RIGHT$ (Q4$,1)
10080 IF QK2$<"A" OR QK2$>"Z" THEN 10100
10090 Q4$=QK1$+CHR$ (ASC QK2$+&20)
10100 R6=0:RESTORE QSI
10110 FOR QI=QSI TO QSM
10120 READ QS1$,QS2$
10130 IF Q4$=QS1$ THEN R6=VAL QS2$:QI=QSM
10140 NEXT
10150 IF R6=0 THEN 10460
10160 CLS :PRINT "  : isotope |    mass   | abundance "
10170 RESTORE R6
10180 FOR QJ=0 TO 2
10190 QW1$="":QW2$="":QW3$="":P2$=""
10200 READ P2$
10210 IF P2$="@" THEN 10240
10220 QCK$=LEFT$ (P2$,1):IF QCK$="&" THEN QCK=VAL P2$:P2$=CHR$ QCK
10230 QW1$=QW1$+P2$ : GOTO 10200
10240 READ QW2$
10250 READ P2$
10260 IF P2$="@" THEN 10290
10270 QCK$=LEFT$ (P2$,1):IF QCK$="&" THEN QCK=VAL P2$:P2$=CHR$ QCK
10280 QW3$=QW3$+P2$:GOTO 10250
10290 QLT=LEN QW1$:QWK$=LEFT$ (QCL$,8-QLT)
10300 LOCATE 0,QJ+&1:PRINT "    ";QW1$;QWK$
10310 QLT=LEN QW2$:QWK$=LEFT$ (QCL$,12-QLT)
10320 LOCATE 12,QJ+&1:PRINT "| ";QW2$;QWK$
10330 QLT=LEN QW3$:QWK$=LEFT$ (QCL$,9-QLT)
10340 LOCATE 24,QJ+&1:PRINT "|  ";QW3$;QWK$
10350 LOCATE 36,QJ+&1:PRINT "%"
10360 NEXT
10370 Q4$=INKEY$ &1:P1=ASC Q4$
10380 IF P1=&4 THEN R6=R6-1:GOTO 10430
10390 IF P1=&5 THEN R6=R6+1:GOTO 10430
10400 IF P1=&E THEN R6=R6+10:GOTO 10430
10410 IF P1=&F THEN R6=R6-10:GOTO 10430
10420 IF P1=&D THEN 10030
10430 IF R6>QDM-2 THEN R6=QDM-2
10440 IF R6<QDI THEN R6=QDI
10450 GOTO 10170
10460 CLS :LOCATE 9,0:PRINT QMSG$:LOCATE 11,3:PRINT "Symbol not found"
10470 GOSUB *REK:GOTO 10030
